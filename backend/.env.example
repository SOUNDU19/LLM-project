# MongoDB (Atlas) — include database name in URI or set MONGODB_DB_NAME
# Example: mongodb+srv://user:pass@cluster.mongodb.net/smart_helpdesk?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_helpdesk
MONGODB_DB_NAME=smart_helpdesk

# Groq LLM
GROQ_API_KEY=your_groq_api_key_here

# JWT
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS — comma-separated origins (Vercel URL + local dev)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: primary frontend URL (also added to CORS)
FRONTEND_URL=http://localhost:5173

# Optional: ChromaDB persistence directory (use /tmp/chroma_db on Render if needed)
# CHROMA_PERSIST_DIR=./app/chroma_db_dir
